{
  "schema_version": 1,
  "adapters": {
    "claude-code": {
      "home_paths": [".claude.json"]
    },
    "agy": {
      "home_paths": [
        ".gemini/settings.json",
        ".gemini/antigravity-cli/antigravity-oauth-token"
      ]
    },
    "hermes": {
      "home_paths": [".hermes/.env", ".hermes/config.yaml"]
    },
    "pi": {
      "home_paths": [".pi/agent/auth.json", ".pi/agent/settings.json"]
    }
  }
}

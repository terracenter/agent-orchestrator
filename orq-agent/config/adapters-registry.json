{
  "schema_version": 1,
  "adapters": [
    {
      "name": "pi",
      "binary": "pi",
      "status": "available",
      "argv": [
        "--model",
        "$MODEL",
        "--print",
        "$TASK"
      ],
      "detect": {
        "version_args": [
          "--version"
        ],
        "version_args_verified": false,
        "models": {
          "source": "catalog"
        }
      }
    },
    {
      "name": "openclaw",
      "binary": "openclaw",
      "status": "available",
      "argv": [
        "--model",
        "$MODEL",
        "--prompt",
        "$TASK"
      ],
      "detect": {
        "version_args": [
          "--version"
        ],
        "version_args_verified": false,
        "models": {
          "source": "catalog"
        }
      }
    },
    {
      "name": "agy",
      "binary": "agy",
      "status": "available",
      "argv": [
        "--model",
        "$MODEL",
        "--prompt",
        "$TASK"
      ],
      "detect": {
        "version_args": [
          "--version"
        ],
        "version_args_verified": false,
        "models": {
          "source": "catalog"
        }
      }
    },
    {
      "name": "qwen-code",
      "binary": "qwen",
      "status": "available",
      "argv": [
        "--safe-mode",
        "-m",
        "$MODEL",
        "-p",
        "$TASK",
        "--output-format",
        "text"
      ],
      "detect": {
        "version_args": [
          "--version"
        ],
        "version_args_verified": false,
        "models": {
          "source": "catalog"
        }
      }
    },
    {
      "name": "hermes",
      "binary": "hermes",
      "status": "available",
      "argv": [
        "-m",
        "$MODEL",
        "-z",
        "$TASK"
      ],
      "detect": {
        "version_args": [
          "--version"
        ],
        "version_args_verified": true,
        "models": {
          "source": "config",
          "path": "$HERMES_HOME/provider_models_cache.json",
          "note": "model picker cache / config agent.model (sin leer secretos)"
        }
      }
    },
    {
      "name": "claude-code",
      "binary": "claude",
      "status": "gated",
      "argv": [
        "--model",
        "$MODEL",
        "--print",
        "--",
        "$TASK"
      ],
      "detect": {
        "version_args": [
          "--version"
        ],
        "version_args_verified": true,
        "models": {
          "source": "aliases",
          "aliases": [
            "fable",
            "opus",
            "sonnet"
          ]
        }
      }
    },
    {
      "name": "codex",
      "binary": "codex",
      "status": "available",
      "argv": [
        "exec",
        "--model",
        "$MODEL",
        "--sandbox",
        "workspace-write",
        "--",
        "$TASK"
      ],
      "detect": {
        "version_args": [
          "--version"
        ],
        "version_args_verified": false,
        "models": {
          "source": "catalog"
        }
      }
    }
  ]
}
